# Server Configuration
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
JWT_SECRET=kagaz-dev-secret-key-change-in-production-2026

# Local Docker PostgreSQL Connection
# Matches credentials in root docker-compose.yml:
# user: postgres | password: postgres | db: kagaz | port: 5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kagaz

# Web DB Viewer (Adminer):
# Available at http://localhost:8080 (Server: postgres, User: postgres, Pass: postgres, DB: kagaz)

# Cloudinary Storage Configuration
# Sign up free at https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# or use the single CLOUDINARY_URL string:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Document auto-expiration in minutes (default: 60 mins)
DOCUMENT_TTL_MINUTES=60
